{
  "$schema": "https://desirecore.net/schemas/agentfs/v1/agent-config.json",
  "version": "0.2.0",
  "llm": {
    "routingMode": "fixed",
    "smart": {
      "profile": {
        "tier": "flagship",
        "requiredCapabilities": [
          "vision",
          "tool_use"
        ],
        "reasoning": "auto"
      }
    },
    "provider": "desirecore-cloud",
    "providerId": "desirecore-cloud",
    "model": "qwen3.8-max",
    "maxRetryDelayMs": 32000
  },
  "heartbeat": {
    "enabled": false
  },
  "session_mode": {
    "manual": true
  },
  "env": {
    "enabled": true,
    "includeWeekday": true,
    "includeLocalTime": true,
    "includeSessionStart": true,
    "includeOs": true,
    "includeRuntime": true,
    "includeManagedRuntimes": true
  },
  "mcp_servers": {},
  "capabilities": [],
  "trigger_patterns": [],
  "accepts_handoff": true,
  "accepts_messages": true,
  "max_concurrent_sessions": 3,
  "id": "9d40bb41-24b8-4fc3-845e-02adeae6d3c2",
  "name": "标书总审",
  "description": "标书总审：以明确目标协调专业成员，按成果质量验收并交付整改建议"
}
