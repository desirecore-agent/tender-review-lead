{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tender-review/lead-task-spec-check/v1/schema.json",
  "type": "object",
  "description": "Read-only checker outcome. Pass means deterministic checks only, never semantic completeness or platform authorization.",
  "additionalProperties": false,
  "required": [
    "result_version",
    "result",
    "spec_sha256",
    "checks",
    "semantic_completeness",
    "violations",
    "read_file_count",
    "mode",
    "physical_scope_status",
    "file_stability_status",
    "deadline_mode",
    "capture_provenance",
    "capture_check_count"
  ],
  "properties": {
    "result_version": {
      "const": "lead-task-spec-check/v1",
      "description": "Exact output contract."
    },
    "result": {
      "type": "string",
      "minLength": 1,
      "description": "Outcome; exit 0=pass, 1=validation failure, 2=dependency/IO/CLI failure.",
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "spec_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$",
      "description": "Observed spec hash when read; null if unavailable."
    },
    "checks": {
      "type": "object",
      "description": "Actual deterministic checks completed.",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "runtime_lock",
        "sources",
        "references",
        "scopes",
        "resources",
        "stability"
      ],
      "properties": {
        "schema": {
          "type": "boolean",
          "description": "Authority and TaskSpec conform to shipped closed Draft-07 schemas."
        },
        "authority": {
          "type": "boolean",
          "description": "Task metadata matches caller-supplied bindings; does not authenticate caller origin."
        },
        "runtime_lock": {
          "type": "boolean",
          "description": "Interpreter/prefix and installed package versions match caller-bound reviewed lock; not a wheel-provenance audit."
        },
        "sources": {
          "type": "boolean",
          "description": "Spec source bytes match independent caller inline instructions and declared hashes."
        },
        "references": {
          "type": "boolean",
          "description": "IDs are unique, references resolve and declared constraints have acceptance references; no proof that all natural-language constraints were extracted."
        },
        "scopes": {
          "type": "boolean",
          "description": "Grant and ownership checks completed; physical identity status is separately reported by mode."
        },
        "resources": {
          "type": "boolean",
          "description": "Declared resource file bytes match hashes; version meaning remains source/evidence review."
        },
        "stability": {
          "type": "boolean",
          "description": "File identity/hash stability in file mode, or supplied-buffer hash consistency in inline mode; see file_stability_status."
        }
      }
    },
    "semantic_completeness": {
      "const": "not_established",
      "description": "Natural-language completeness/equivalence and model obedience still require independent review."
    },
    "violations": {
      "type": "array",
      "description": "Generic diagnostic codes; no source text or secret-bearing input values are echoed.",
      "items": {
        "type": "object",
        "description": "One diagnostic.",
        "additionalProperties": false,
        "required": [
          "code",
          "subject"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Stable checker diagnostic code."
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "description": "Public schema section or generic operation name."
          }
        }
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "read_file_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of bounded regular-file reads by the checker."
    },
    "mode": {
      "type": "string",
      "minLength": 1,
      "description": "Actual invocation mode.",
      "enum": [
        "file-posix",
        "inline"
      ]
    },
    "physical_scope_status": {
      "type": "string",
      "minLength": 1,
      "description": "Physical existing-path ancestry checked only in file-posix mode. Inline logical disjointness is not OS identity proof.",
      "enum": [
        "verified_existing_paths",
        "not_checked_inline",
        "not_completed"
      ]
    },
    "file_stability_status": {
      "type": "string",
      "minLength": 1,
      "description": "OS identities/hash re-read only in file mode; inline checks supplied immutable byte buffers only.",
      "enum": [
        "verified",
        "not_checked_inline",
        "not_completed"
      ]
    },
    "deadline_mode": {
      "type": "string",
      "minLength": 1,
      "description": "Checker-internal mechanism, not an external platform timeout.",
      "enum": [
        "signal",
        "thread-watchdog",
        "not_started"
      ]
    },
    "capture_provenance": {
      "type": "string",
      "minLength": 1,
      "description": "Whether actual file reads or caller-supplied captures were used; no authentication of external capture claims.",
      "enum": [
        "not_applicable",
        "caller_supplied_not_authenticated"
      ]
    },
    "capture_check_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Checks on supplied inline byte buffers; separate from filesystem reads."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "violations": {
            "maxItems": 0
          },
          "checks": {
            "properties": {
              "schema": {
                "const": true
              },
              "authority": {
                "const": true
              },
              "runtime_lock": {
                "const": true
              },
              "sources": {
                "const": true
              },
              "references": {
                "const": true
              },
              "scopes": {
                "const": true
              },
              "resources": {
                "const": true
              },
              "stability": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "file-posix"
          },
          "result": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "physical_scope_status": {
            "const": "verified_existing_paths"
          },
          "file_stability_status": {
            "const": "verified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "inline"
          },
          "result": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "physical_scope_status": {
            "const": "not_checked_inline"
          },
          "file_stability_status": {
            "const": "not_checked_inline"
          },
          "deadline_mode": {
            "const": "thread-watchdog"
          },
          "capture_provenance": {
            "const": "caller_supplied_not_authenticated"
          }
        }
      }
    }
  ]
}
