{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "kind",
    "role",
    "target_agent_id",
    "original_request",
    "assignment"
  ],
  "properties": {
    "protocol": {
      "const": "tender-delegation-input/v1"
    },
    "kind": {
      "const": "lead-request"
    },
    "role": {
      "const": "lead"
    },
    "target_agent_id": {
      "type": "string",
      "minLength": 1,
      "description": "Current verified target; stable semantic role is separate from identity."
    },
    "original_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_length",
        "text"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Exact existing authorized path; grants no access."
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "description": "Original file byte SHA-256. Shape only; hexadecimal and identity are checked outside this structural gate."
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Complete original UTF-8 request, read from exact original bytes; never paraphrased."
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_task",
        "io_scope",
        "resources",
        "parent_plan",
        "delivery_requirements"
      ],
      "properties": {
        "role_task": {
          "type": "string",
          "minLength": 1,
          "description": "Bounded role task; does not replace original request."
        },
        "io_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_only_paths",
            "callee_write_paths",
            "lead_write_paths"
          ],
          "properties": {
            "read_only_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Authorized path, not a grant."
              },
              "minItems": 1,
              "maxItems": 256
            },
            "callee_write_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Authorized path, not a grant."
              },
              "minItems": 1,
              "maxItems": 256
            },
            "lead_write_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Authorized path, not a grant."
              },
              "minItems": 1,
              "maxItems": 256
            }
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_id",
              "constraint_ids",
              "kind",
              "path",
              "sha256"
            ],
            "properties": {
              "resource_id": {
                "type": "string",
                "minLength": 1,
                "description": "Current binding identity."
              },
              "constraint_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Constraint identity."
                },
                "minItems": 1,
                "maxItems": 256
              },
              "kind": {
                "enum": [
                  "installed_skill",
                  "helper",
                  "runtime_executable",
                  "dependency_lock",
                  "input_manifest",
                  "capability_receipt",
                  "contract_schema",
                  "other"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Verified resource path; no grant."
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "description": "Original file byte SHA-256. Shape only; hexadecimal and identity are checked outside this structural gate."
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "description": "Actual observed version if applicable."
              }
            }
          },
          "minItems": 0,
          "maxItems": 256
        },
        "parent_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "revision"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Current authoritative Plan path."
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "delivery_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Required delivery evidence."
          },
          "minItems": 1,
          "maxItems": 256
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tender delegation input structural projection v1",
  "description": "Candidate for an unreleased platform interface. Shape does not prove authorization, truthful execution, complete semantics, or successful specialist review. Original TaskSpec/checker remains authoritative."
}
